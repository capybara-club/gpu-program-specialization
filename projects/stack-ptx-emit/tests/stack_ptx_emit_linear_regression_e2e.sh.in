set -euo pipefail

GEN="@STACK_PTX_EMIT_LINEAR_REGRESSION_E2E_GENERATOR_PATH@"
CC_BIN="@CMAKE_C_COMPILER@"
NVCC_BIN="@CMAKE_CUDA_COMPILER@"
RUSTC_BIN="@STACK_PTX_EMIT_RUSTC_EXECUTABLE@"
PYTHON_BIN="@Python3_EXECUTABLE@"

if [[ ! -x "$GEN" ]]; then
    echo "Missing generator executable: $GEN" >&2
    exit 1
fi

if [[ ! -x "$CC_BIN" ]]; then
    echo "C compiler not found: $CC_BIN" >&2
    exit 1
fi

if [[ -z "$RUSTC_BIN" || ! -x "$RUSTC_BIN" ]]; then
    echo "rustc not found; skipping" >&2
    exit 77
fi

if [[ ! -x "$NVCC_BIN" ]]; then
    echo "nvcc not found; skipping" >&2
    exit 77
fi

if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "python not found: $PYTHON_BIN" >&2
    exit 1
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$GEN" "$tmpdir"

declare -a runnable_backends=(
    c
    rust
    cuda
    numpy
)

for backend in "${runnable_backends[@]}"; do
    case "$backend" in
        c)
            "$CC_BIN" -std=c99 -O2 -fno-fast-math -ffp-contract=off \
                "$tmpdir/run_c.c" -lm -o "$tmpdir/run_c"
            "$tmpdir/run_c" > "$tmpdir/c.out"
            ;;
        rust)
            "$RUSTC_BIN" "$tmpdir/run_rust.rs" -A warnings -C opt-level=2 -o "$tmpdir/run_rust"
            "$tmpdir/run_rust" > "$tmpdir/rust.out"
            ;;
        cuda)
            "$NVCC_BIN" -std=c++17 -O2 --fmad=false \
                "$tmpdir/run_cuda.cu" -o "$tmpdir/run_cuda"
            "$tmpdir/run_cuda" > "$tmpdir/cuda.out"
            ;;
        numpy)
            "$PYTHON_BIN" "$tmpdir/run_numpy.py" > "$tmpdir/numpy.out"
            ;;
        *)
            echo "Unexpected backend: $backend" >&2
            exit 1
            ;;
    esac

    if ! cmp -s "$tmpdir/expected.txt" "$tmpdir/${backend}.out"; then
        echo "Expected output mismatch for backend ${backend}" >&2
        echo "--- expected ---" >&2
        cat "$tmpdir/expected.txt" >&2
        echo "--- ${backend} ---" >&2
        cat "$tmpdir/${backend}.out" >&2
        exit 1
    fi
done

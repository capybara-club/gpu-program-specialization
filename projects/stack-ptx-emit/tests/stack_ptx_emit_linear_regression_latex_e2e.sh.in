set -euo pipefail

GENERATOR="@STACK_PTX_EMIT_LINEAR_REGRESSION_LATEX_E2E_GENERATOR_PATH@"
PDFLATEX_BIN="@STACK_PTX_EMIT_PDFLATEX_EXECUTABLE@"

if [[ ! -x "$GENERATOR" ]]; then
    echo "Missing generator executable: $GENERATOR" >&2
    exit 1
fi

if [[ -z "$PDFLATEX_BIN" || ! -x "$PDFLATEX_BIN" ]]; then
    echo "pdflatex not found; skipping" >&2
    exit 77
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$GENERATOR" "$tmpdir"

if [[ ! -f "$tmpdir/linear_regression_model.tex" ]]; then
    echo "Missing generated TeX file" >&2
    exit 1
fi

"$PDFLATEX_BIN" \
    -interaction=nonstopmode \
    -halt-on-error \
    -output-directory "$tmpdir" \
    "$tmpdir/linear_regression_model.tex" >/dev/null

if [[ ! -f "$tmpdir/linear_regression_model.pdf" ]]; then
    echo "Missing rendered PDF" >&2
    exit 1
fi

+/* White-box compiler regression: no CUDA device is needed to check CSE keys,
+ * instruction counts, ownership, and register-pressure behavior. */
+#include "../s_cubin_specialize.c"
+#include <stdio.h>
+#include <stdlib.h>
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+#define COL(i) secant_ast_encode_column_f32(i)
+#define BANK(i) secant_ast_encode_bank_constant_f32(i)
+#define TOG(i) secant_ast_encode_toggle2_f32(i)
+#define FOUR(i,j) secant_ast_encode_toggle4_f32(i,j)
+#define RET secant_ast_encode_return_f32
+static size_t compile(const uint8_t *const *asts, size_t n, int reuse, size_t scratch,
+                      size_t *instructions, uint32_t *regs) {
+    uint8_t inputs[] = {0, 1, 2, 3}, targets[] = {4}, accum[32], free_regs[40];
+    unsigned char code[4096 * 16];
+    _SecantCubinSite site;
+    size_t i, selects = 0;
+    memset(&site, 0, sizeof(site));
+    site.permutation_reg = 5;
+    site.predicate_reg = 0;
+    /* An inspected predicate instruction's payload is immaterial to counting
+     * selectors; GPU tests exercise real inspected instructions. */
+    for (i = 0; i < 32; ++i) accum[i] = (uint8_t)(6 + i);
+    for (i = 0; i < scratch; ++i) free_regs[i] = (uint8_t)(38 + i);
+    CHECK(_secant_cubin_generate_sse_sass(inputs, 4, _SECANT_CUBIN_SHAPE_TOGGLE_SSE,
+        2, targets, 1, free_regs, scratch, accum, n, 0, (uint32_t)(38 + scratch),
+        NULL, 0, NULL, asts, n, &site, reuse, code, 4096, instructions, regs) == SECANT_SUCCESS);
+    for (i = 0; i < *instructions; ++i) {
+        uint64_t word;
+        memcpy(&word, code + i * 16, sizeof(word));
+        selects += (word & 0xffffu) == _SECANT_CUBIN_OPCODE_FSEL;
+    }
+    return selects;
+}
+int main(void) {
+    const uint8_t two[] = {COL(0), BANK(0), TOG(0), RET};
+    const uint8_t other_bit[] = {COL(0), BANK(0), TOG(1), RET};
+    const uint8_t reversed[] = {BANK(0), COL(0), TOG(0), RET};
+    const uint8_t four[] = {COL(0), COL(1), BANK(0), BANK(1), FOUR(0, 1), RET};
+    const uint8_t swapped[] = {COL(0), COL(1), BANK(0), BANK(1), FOUR(1, 0), RET};
+    const uint8_t plus_zero[] = {secant_ast_encode_constant_f32_bits(0), COL(0), TOG(0), RET};
+    const uint8_t minus_zero[] = {secant_ast_encode_constant_f32_bits(0x80000000u), COL(0), TOG(0), RET};
+    const uint8_t arithmetic[] = {COL(0), BANK(0), TOG(0), COL(0), BANK(0), TOG(0),
+        secant_ast_encode_mul_f32, secant_ast_encode_sin_f32, RET};
+    const uint8_t *asts[32];
+    size_t i, old_count, new_count;
+    uint32_t old_regs, new_regs;
+    for (i = 0; i < 8; ++i) asts[i] = arithmetic;
+    CHECK(compile(asts, 8, 0, 24, &old_count, &old_regs) == 16);
+    CHECK(compile(asts, 8, 1, 24, &new_count, &new_regs) == 1);
+    CHECK(new_count < old_count && new_regs <= old_regs);
+    /* No spare-register budget: keep the ordinary implementation. */
+    CHECK(compile(asts, 8, 1, 0, &new_count, &new_regs) == 16);
+    asts[0] = two; asts[1] = other_bit; asts[2] = reversed;
+    asts[3] = four; asts[4] = swapped; asts[5] = plus_zero; asts[6] = minus_zero;
+    for (i = 0; i < 7; ++i) asts[7+i] = asts[i];
+    CHECK(compile(asts, 14, 0, 24, &old_count, &old_regs) == 22);
+    CHECK(compile(asts, 14, 1, 24, &new_count, &new_regs) == 11);
+    /* A subsequent patch has no retained values from this one. */
+    asts[0] = four;
+    CHECK(compile(asts, 1, 1, 24, &new_count, &new_regs) == 3);
+    puts("selector CSE identity, instruction reuse, register budget and patch isolation passed");
+    return 0;
+}

{
  "version": 1,
  "states": ["x0", "x1", "x2", "x3", "x4"],
  "integration": {"method": "rk4", "dt": 0.01},
  "leaves": {
    "source": {"states": ["x0", "x1", "x2", "x3", "x4"], "arity": 2, "coverage": "all"},
    "partner": {"states": ["x0", "x1", "x2", "x3", "x4"], "arity": 4, "coverage": "all"}
  },
  "rules": {
    "Interaction(a,b)": [
      {"expr": "a*sin(b)", "tags": ["oscillatory"]},
      {"expr": "a/(1+pow(b,2))", "tags": ["saturating"]}
    ]
  },
  "rhs": {
    "x0": "hole(Interaction,leaf.source,leaf.partner)",
    "x1": "-x1", "x2": "-x2", "x3": "-x3", "x4": "-x4"
  },
  "limits": {"max_skeletons": 10, "max_variants": 1000, "max_configurations": 10000},
  "retain": {"global": 10, "by_tag": {"oscillatory": 3, "saturating": 3}}
}

__pycache__/
*.py[cod]
.venv/
build/
dist/
generated/
scratch/**/build/
*.egg-info/

# Experiment outputs live in full workspace checkpoints (see docs/backups.md).
# Keep source, analysis scripts, and Markdown reports versioned.
scratch/**/bin/
scratch/**/build-sanitize/
scratch/**/*.json
scratch/**/*.jsonl
scratch/**/*.csv
scratch/**/*.bin
scratch/**/*.ast
scratch/**/*.winners
scratch/**/*.stderr
scratch/**/*.stdout
scratch/**/*.log
scratch/**/*.lock
scratch/**/*.tar
scratch/**/*.gz
scratch/**/*.zip
scratch/**/*.cubin
scratch/**/*.ptx
scratch/**/*.sass
scratch/**/*.so
scratch/**/*.dylib
scratch/**/*.o
scratch/**/*.png
scratch/**/*.pdf
scratch/**/*.html
scratch/**/*.txt

# Reusable requests, protocols, fixtures, and dependency declarations are source.
!scratch/**/examples/**/*.json
!scratch/**/*_example.json
!scratch/**/example.json
!scratch/**/*_fixture.json
!scratch/**/protocol*.json
!scratch/**/*config*.json
!scratch/**/FORK_BASELINE.json
!scratch/**/requirements*.txt

# Generated requests and private generator records are campaign artifacts too.
scratch/**/validation/**/*.json
scratch/**/private/**/*.json
scratch/recovery5_v2/exp-depth2/protocol.json
scratch/recovery5_v2/exp-phase-expand/protocol.json
scratch/**/exit-status
scratch/**/*-exit-status
scratch/**/lock
scratch/game_probe_validation/contract-test
scratch/game_probe_validation/enum-test
scratch/game_probe_validation/enum-regression

# Keep credentials outside version control; full checkpoints have private access.
.env
.env.*
!.env.example
*.pem
*.key

# Native-service campaigns: source and concise reports belong in Git; generated
# traces, logs, ranking populations and bulk results belong in checkpoints.
/benchmarks/cache_retention/results/*
!/benchmarks/cache_retention/results/summary.json
/benchmarks/grammar_overhead/results/
/benchmarks/score_topk/results/
/benchmarks/score_topk/integration/results/
/benchmarks/score_topk/integration/*.json
!/benchmarks/score_topk/integration/deployment.json
!/benchmarks/score_topk/integration/deviations.json
!/benchmarks/score_topk/integration/manifest.json
/docs/grammar/*validation/
/service_trial/validation/*

# Reusable request fixtures and the small reference outputs consumed by native
# regression tests are intentional exceptions, not ongoing campaign output.
!/service_trial/validation/requests/
!/service_trial/validation/direct-reference.json
!/service_trial/validation/million-2048-request.json
!/service_trial/validation/million-direct-attempt.json

# Detailed timing/sizing evidence is archived separately from source.
benchmarks/request_sizing/results/
